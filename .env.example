GMAIL_USER=yourgmail@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password
EMAIL_TO=your-recipient@gmail.com

SOURCE_URL=https://exam.tu.edu.np/notices
MAX_PAGES=20
FIRST_RUN_LIMIT=10
STATE_FILE=./data/state.json

# Android control API. Generate with: openssl rand -hex 32
API_SECRET=replace-with-a-random-secret-of-at-least-24-characters
TOKEN_TTL_SECONDS=900
PORT=8787
HOST=0.0.0.0

# Fine-grained GitHub token permissions:
# Actions read/write, Contents read/write, Variables read/write
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_WORKFLOW=bot.yml
GITHUB_REF=main
GITHUB_STATE_PATH=data/state.json
